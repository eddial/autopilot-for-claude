{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import", "vitest", "react"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css", "@fontsource-variable/*"]
      }
    ],
    "react/react-in-jsx-scope": "off",
    "react/style-prop-object": [
      "error",
      {
        "allow": ["StatusBar"]
      }
    ]
  },
  "ignorePatterns": ["**/schema/**", "**/node_modules/**", "**/dist/**"],
  "overrides": [
    {
      "files": ["packages/contracts/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["node:*"],
                "message": "The contract runs on every client, the iPhone included: no Node built-ins."
              },
              {
                "group": ["@autopilot/*"],
                "message": "The contract depends on nothing of ours."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/design/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["node:*", "@autopilot/*"],
                "message": "The tokens run everywhere, the iPhone included, and depend on nothing."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/client/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["node:*", "undici"],
                "allowTypeImports": true,
                "message": "The client runs on the iPhone; Node-only code goes in src/node.ts."
              },
              {
                "group": ["@autopilot/server", "@autopilot/server/*"],
                "message": "Clients talk to the server through the contract only."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/client/src/node.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["apps/mobile/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["node:*", "undici", "electron"],
                "message": "Hermes on the iPhone has none of these."
              },
              {
                "group": ["@autopilot/server", "@autopilot/server/*", "@autopilot/client/node", "../../desktop/*"],
                "message": "The phone uses the contract and @autopilot/client only."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/desktop/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["node:*", "electron", "undici"],
                "allowTypeImports": true,
                "message": "The window is a sandboxed page: talk to the shell through window.autopilotShell."
              },
              {
                "group": ["@autopilot/server", "@autopilot/server/*", "@autopilot/client/node"],
                "message": "The window reaches the server through the contract only."
              }
            ]
          }
        ],
        "react/forbid-elements": [
          "error",
          {
            "forbid": [
              {
                "element": "button",
                "message": "Use Button from src/ui.tsx: one of its kinds, or add a kind there."
              }
            ]
          }
        ],
        "react/forbid-dom-props": [
          "error",
          {
            "forbid": [
              {
                "propName": "style",
                "message": "Lay out with a class in styles.css or Row/Column from src/ui.tsx; colours come from the tokens."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/server/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@autopilot/desktop", "@autopilot/mobile", "@autopilot/client", "@autopilot/client/*"],
                "message": "The server depends on the contract, not on its clients."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/desktop/src/ui.tsx"],
      "rules": {
        "react/forbid-elements": "off",
        "react/forbid-dom-props": "off"
      }
    },
    {
      "files": ["apps/mobile/**", "packages/client/src/**", "packages/contracts/src/**", "packages/design/src/**"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "property": "toSorted",
            "message": "Hermes on the iPhone has no toSorted: copy and sort in place."
          },
          {
            "property": "toReversed",
            "message": "Hermes on the iPhone has no toReversed."
          },
          {
            "property": "toSpliced",
            "message": "Hermes on the iPhone has no toSpliced."
          },
          {
            "object": "AbortSignal",
            "property": "timeout",
            "message": "Hermes has no AbortSignal.timeout: use timeoutSignal from @autopilot/client."
          },
          {
            "object": "crypto",
            "property": "randomUUID",
            "message": "Hermes has no crypto.randomUUID: use expo-crypto on the phone."
          }
        ]
      }
    }
  ]
}
