{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "name": {
      "type": "string"
    },
    "roles": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "main",
          "runner"
        ]
      }
    },
    "capacity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "running": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "workstreams": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "socket",
              "lan",
              "tailscale"
            ]
          },
          "address": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "address"
        ],
        "additionalProperties": false
      }
    },
    "health": {
      "type": "string",
      "enum": [
        "online",
        "offline",
        "asleep"
      ]
    },
    "lastSeenAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "description": "ISO 8601 timestamp"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "name",
    "roles",
    "capacity",
    "running",
    "workstreams",
    "routes",
    "health",
    "lastSeenAt"
  ],
  "additionalProperties": false
}
