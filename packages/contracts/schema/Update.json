{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "taskId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-\\d+$",
      "description": "Task identifier, e.g. AP-212"
    },
    "kind": {
      "type": "string",
      "enum": [
        "decision",
        "question",
        "review",
        "blocked",
        "waiting",
        "done",
        "info",
        "signal",
        "instruction",
        "event"
      ]
    },
    "body": {
      "type": "string",
      "maxLength": 20000,
      "description": "Markdown"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "waitingOn": {
      "type": [
        "string",
        "null"
      ]
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "subtitle": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "url",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "author": {
      "type": "string",
      "enum": [
        "owner",
        "session",
        "signal",
        "watcher",
        "system",
        "scout"
      ]
    },
    "answers": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "open": {
      "type": "boolean"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO 8601 timestamp"
    }
  },
  "required": [
    "id",
    "taskId",
    "kind",
    "body",
    "options",
    "waitingOn",
    "attachments",
    "author",
    "answers",
    "open",
    "createdAt"
  ],
  "additionalProperties": false
}
