{
  "name": "autopilot-for-claude",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p scripts",
    "test": "vitest run",
    "lint": "oxlint && prettier --check --log-level warn \"**/*.{ts,tsx,js,mjs,cjs,json,css,yml,yaml}\"",
    "schema": "pnpm --filter @autopilot/contracts schema",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "autopilot": "node apps/server/bin/autopilot.js",
    "desktop": "pnpm --filter @autopilot/desktop start",
    "mac-check": "bash scripts/mac-check.sh",
    "perf": "pnpm --filter @autopilot/desktop perf",
    "format": "prettier --write --log-level warn \"**/*.{ts,tsx,js,mjs,cjs,json,css,yml,yaml}\""
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxlint": "^1.89.0",
    "prettier": "3.9.10",
    "typescript": "catalog:",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ]
  }
}
